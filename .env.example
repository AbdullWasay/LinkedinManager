# Application
APP_NAME="AI Job Hunter"
APP_ENV=development
SECRET_KEY=change-me-to-a-long-random-string
FRONTEND_URL=http://localhost:3000
API_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Vercel (apps/web) — set these in the Vercel project env
# API_PROXY_TARGET=https://your-api.onrender.com
# NEXT_PUBLIC_API_URL=   (leave empty on Vercel to use same-origin /api rewrite)

# Database / Redis (overridden in docker-compose)
DATABASE_URL=postgresql+psycopg://jobhunter:jobhunter@localhost:5432/ai_job_hunter
REDIS_URL=redis://localhost:6379/0

# Single-user bootstrap
DEFAULT_USER_EMAIL=abdulwasay@example.com
DEFAULT_USER_NAME="Abdul Wasay"

# App login — required for deploy so only you can open the dashboard
AUTH_PASSWORD=change-me-strong-password
ALLOWED_LOGIN_EMAILS=you@gmail.com
SESSION_MAX_AGE_HOURS=168
AUTH_DISABLED=false

# Token encryption (generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
TOKEN_ENCRYPTION_KEY=

# Google OAuth (required for Phase 2 live verification)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback
GOOGLE_SHEETS_TITLE="AI Job Hunter - Abdul Wasay"

# AI providers (at least one required for personalized emails)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Optional search
SERPAPI_API_KEY=
